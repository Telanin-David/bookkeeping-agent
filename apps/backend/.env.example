# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/bookkeeping_agent

# ── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Calendar days ("today", due dates, report periods) are counted in this time zone.
BUSINESS_TIME_ZONE=Africa/Lagos
# Number of reverse proxies in front of the API: 0 locally, 1 behind nginx on the VPS.
# Needed for the per-IP login rate limit to see real visitor IPs.
TRUST_PROXY=0

# ── JWT ──────────────────────────────────────────────────────
# At least 32 random characters; production refuses to start otherwise.
# Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
# How long a device stays signed in without logging in again
JWT_REFRESH_EXPIRES_IN=7d

# ── Anthropic (Claude) ───────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# The chat assistant's model. Leave empty for Claude Sonnet 5.5. claude-haiku-4-5 costs about
# a third as much but sometimes says it saved something without saving it.
# Each message's token use and estimated cost is logged as "chat usage".
CHAT_MODEL=
# Messages each owner can send the assistant per day (resets at midnight Lagos time).
# 0 means no limit. Admins are never limited. Default 20.
CHAT_DAILY_LIMIT=20

# ── Plans and payments ───────────────────────────────────────
# Off by default: every owner gets every feature and CHAT_DAILY_LIMIT applies.
# When on: a free trial for each owner, then the free plan (no assistant, 1 shop) or a paid
# plan: Monthly ₦5,000 or Yearly ₦50,000 (6 assistant messages a day). Prices are in
# src/services/plans.ts. Run `npm run migrate` first (migration 013).
BILLING_ENABLED=false
TRIAL_DAYS=14
# Assistant messages for the whole trial
TRIAL_MESSAGES=40
# Paystack → Settings → API Keys & Webhooks. Use the sk_test_ key until a test payment works,
# then the sk_live_ key. Set the Webhook URL there to
# https://<your API>/api/v1/billing/paystack/webhook
# Empty: owners can't pay online; record transfers by hand on the admin page.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# ── Email (SMTP) ─────────────────────────────────────────────
# Any provider's SMTP details (Brevo, Amazon SES, Zoho, Mailgun…). Leave SMTP_HOST
# empty in development to write emails to EMAIL_OUTBOX_DIR as .eml files instead.
# EMAIL_FROM's domain needs SPF and DKIM records set up with the provider, or
# alerts will land in spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Bookkeeping AI <alerts@yourdomain.com>
EMAIL_OUTBOX_DIR=tmp/outbox

# ── Alerts ───────────────────────────────────────────────────
# Checks for overdue debts and bills due, and emails alerts. Set to "off" on every
# backend instance but one if you ever run more than one.
ALERT_WORKER=on
ALERT_WORKER_INTERVAL_MS=600000
# At most one alert email per person per hour
ALERT_EMAIL_GAP_MS=3600000

# ── Twilio (SMS) — optional ──────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── File storage ─────────────────────────────────────────────
# Set STORAGE_DRIVER=local for dev and a single VPS (files saved under UPLOAD_DIR)
# Set STORAGE_DRIVER=s3 for production
STORAGE_DRIVER=local
# Folder for uploads (Excel imports, shop logos). On the VPS use a persistent, backed-up path.
UPLOAD_DIR=tmp/uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
