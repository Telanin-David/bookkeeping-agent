# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/bookkeeping_agent

# ── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Anthropic (Claude) ───────────────────────────────────────
# Either an API key...
ANTHROPIC_API_KEY=sk-ant-...
# ...or workload identity federation on GCP/AWS/Azure/GitHub Actions (no static key).
# Remove ANTHROPIC_API_KEY entirely when using this: if it is set, even empty, it wins.
# ANTHROPIC_FEDERATION_RULE_ID=
# ANTHROPIC_ORGANIZATION_ID=
# ANTHROPIC_SERVICE_ACCOUNT_ID=
# ANTHROPIC_IDENTITY_TOKEN_FILE=/var/run/secrets/anthropic/token
# Optional overrides — chat agent and auto-categorization models
# CLAUDE_CHAT_MODEL=claude-sonnet-5-5
# CLAUDE_CATEGORIZE_MODEL=claude-haiku-4-5
# Timezone used to resolve "today" for the agent
# APP_TIMEZONE=Africa/Lagos

# ── SendGrid ─────────────────────────────────────────────────
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ── Twilio (SMS) — optional ──────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── File storage ─────────────────────────────────────────────
# Set STORAGE_DRIVER=local for dev (files saved to /tmp/uploads)
# Set STORAGE_DRIVER=s3 for production
STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
